{
  "name": "codex-session-monitor-ui",
  "private": true,
  "version": "6.3.9-dev.0",
  "type": "module",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\scripts\\start-browser-dev.ps1",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "e2e": "node e2e/browser-smoke.mjs",
