{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Session Monitor",
  "version": "6.3.9-dev.0",
  "identifier": "com.codex-session-monitor.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Codex Session Monitor",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "resources": {
      "binaries/codex-monitor-sidecar-x86_64-pc-windows-msvc/": "sidecar/"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
